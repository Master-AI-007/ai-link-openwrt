#!/bin/sh /etc/rc.common
# Copyright (C) 2026 AI-LINK OpenWrt Architecture
# Procd Service Script with nftables TProxy, Policy Routing & Fail-Safe Rollback (v1.0.3)

START=99
STOP=10
USE_PROCD=1

PROG_DAEMON="/usr/share/ai-link/ai-link-daemon.py"
CONF_DIR="/etc/ai-link"
RUN_DIR="/var/run/ai-link"
FW_SCRIPT="/usr/share/ai-link/nftables/apply_nft.sh"
TABLE_ID=162
FWMARK=0x162

# v1.0.2/v1.0.3 FIX: BusyBox 的 `pgrep -x sing-box` 匹配不到 /usr/bin/sing-box
# （/proc/<pid>/comm 明明是 sing-box，-x 仍然返回 1），所以统一走这个探针：
# pidof 依赖 comm，BusyBox 与 procps 都靠得住；再用 pgrep -f 兜一层。
singbox_alive() {
	pidof sing-box >/dev/null 2>&1 && return 0
	pgrep -f "[s]ing-box run" >/dev/null 2>&1 && return 0
	return 1
}

detect_lan_gateway_dns() {
	local gw
	gw=$(ip -4 route show default 2>/dev/null | awk '/default/ {for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}')
	if [ -z "$gw" ]; then
		gw=$(uci -q get network.lan.gateway 2>/dev/null || true)
	fi
	[ -n "$gw" ] && echo "$gw"
}

# DIAG-2 FIX: 停止/重启服务或内核未就绪期间，把 /etc/resolv.conf 与 resolv.conf.auto
# 回退到主路由网关 + 公共 DNS (223.5.5.5 / 119.29.29.29)，防止旁路由自身在停机窗口断网 (CPD No internet)。
fallback_resolv_conf_direct() {
	mkdir -p "$RUN_DIR" /tmp/resolv.conf.d 2>/dev/null || true
	local gw
	gw=$(detect_lan_gateway_dns)
	if [ ! -s /tmp/resolv.conf.d/resolv.conf.auto ] || ! grep -q "^nameserver " /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null; then
		{
			echo "# Auto-fallback by AI-LINK for side-router direct DNS"
			[ -n "$gw" ] && echo "nameserver $gw"
			echo "nameserver 223.5.5.5"
			echo "nameserver 119.29.29.29"
		} > /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null || true
	fi
	{
		echo "search lan"
		[ -n "$gw" ] && echo "nameserver $gw"
		echo "nameserver 223.5.5.5"
		echo "nameserver 119.29.29.29"
		echo "nameserver 127.0.0.1"
	} > /tmp/resolv.conf.ai-link-direct 2>/dev/null || true
	if [ -L /etc/resolv.conf ] || [ ! -e /etc/resolv.conf ]; then
		ln -sf /tmp/resolv.conf.ai-link-direct /etc/resolv.conf 2>/dev/null || cp -f /tmp/resolv.conf.ai-link-direct /etc/resolv.conf 2>/dev/null || true
	else
		cp -f /tmp/resolv.conf.ai-link-direct /etc/resolv.conf 2>/dev/null || true
	fi
}

# DIAG-2 FIX: 当 sing-box (:7874 / :7893) 确认监听后，再把 /etc/resolv.conf 指回 127.0.0.1，
# 同时保留主路由/公共 DNS 作为次级兜底 nameserver。
restore_resolv_conf_local() {
	local gw
	gw=$(detect_lan_gateway_dns)
	{
		echo "search lan"
		echo "nameserver 127.0.0.1"
		[ -n "$gw" ] && echo "nameserver $gw"
		echo "nameserver 223.5.5.5"
	} > /tmp/resolv.conf.ai-link-active 2>/dev/null || true
	if [ -L /etc/resolv.conf ] || [ ! -e /etc/resolv.conf ]; then
		ln -sf /tmp/resolv.conf.ai-link-active /etc/resolv.conf 2>/dev/null || cp -f /tmp/resolv.conf.ai-link-active /etc/resolv.conf 2>/dev/null || true
	else
		cp -f /tmp/resolv.conf.ai-link-active /etc/resolv.conf 2>/dev/null || true
	fi
}

setup_tun_and_routing() {
	modprobe nft_tproxy 2>/dev/null || true
	modprobe nft_socket 2>/dev/null || true
	modprobe tun 2>/dev/null || true

	sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
	sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1 || true
	sysctl -w net.ipv6.conf.default.forwarding=1 >/dev/null 2>&1 || true
	# Loose rp_filter & liberal TCP conntrack for single-armed side-router (br-lan) asymmetric path compatibility
	sysctl -w net.ipv4.conf.all.rp_filter=2 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.conf.default.rp_filter=2 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.conf.br-lan.rp_filter=2 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.conf.all.send_redirects=0 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.conf.default.send_redirects=0 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.conf.br-lan.send_redirects=0 >/dev/null 2>&1 || true
	mkdir -p "$RUN_DIR/sysctl_orig"
	if [ ! -f "$RUN_DIR/sysctl_orig/be_liberal" ]; then
		sysctl -n net.netfilter.nf_conntrack_tcp_be_liberal > "$RUN_DIR/sysctl_orig/be_liberal" 2>/dev/null || echo 0 > "$RUN_DIR/sysctl_orig/be_liberal"
	fi
	sysctl -w net.netfilter.nf_conntrack_tcp_be_liberal=1 >/dev/null 2>&1 || true

	while ip rule del fwmark $FWMARK table $TABLE_ID 2>/dev/null; do :; done
	ip route flush table $TABLE_ID 2>/dev/null || true
	ip rule add fwmark $FWMARK table $TABLE_ID priority 162
	ip route add local default dev lo table $TABLE_ID

	local ipv6_proxy
	config_load 'ai-link'
	config_get_bool ipv6_proxy 'global' 'ipv6_proxy' '0'
	while ip -6 rule del fwmark $FWMARK table $TABLE_ID 2>/dev/null; do :; done
	ip -6 route flush table $TABLE_ID 2>/dev/null || true
	if [ "$ipv6_proxy" -eq 1 ]; then
		ip -6 rule add fwmark $FWMARK table $TABLE_ID priority 162 2>/dev/null || true
		ip -6 route add local default dev lo table $TABLE_ID 2>/dev/null || true
	fi
}

cleanup_routing_and_nft() {
	nft delete table inet ai_link 2>/dev/null || true
	nft delete table ip ai_link 2>/dev/null || true
	while ip rule del fwmark $FWMARK table $TABLE_ID 2>/dev/null; do :; done
	while ip -6 rule del fwmark $FWMARK table $TABLE_ID 2>/dev/null; do :; done
	while ip rule del pref 8999 2>/dev/null; do :; done
	while ip -6 rule del pref 8999 2>/dev/null; do :; done
	ip route flush table $TABLE_ID 2>/dev/null || true
	ip -6 route flush table $TABLE_ID 2>/dev/null || true
	ip -6 route del fc00::/18 dev br-lan 2>/dev/null || ip -6 route del fc00::/18 2>/dev/null || true
	if [ -f "$RUN_DIR/sysctl_orig/be_liberal" ]; then
		sysctl -w net.netfilter.nf_conntrack_tcp_be_liberal="$(cat "$RUN_DIR/sysctl_orig/be_liberal")" >/dev/null 2>&1 || sysctl -w net.netfilter.nf_conntrack_tcp_be_liberal=0 >/dev/null 2>&1 || true
	else
		sysctl -w net.netfilter.nf_conntrack_tcp_be_liberal=0 >/dev/null 2>&1 || true
	fi
}

cleanup_dnsmasq_upstream() {
	local removed=0
	local uci_cdir
	uci_cdir=$(uci -q get dhcp.@dnsmasq[0].confdir 2>/dev/null | cut -d',' -f1 || true)
	for f in /tmp/dnsmasq.d/ai-link-adblock.conf /tmp/dnsmasq.cfg*/ai-link-adblock.conf /var/etc/dnsmasq.d/ai-link-adblock.conf ${uci_cdir:+"$uci_cdir/ai-link-adblock.conf"}; do
		if [ -f "$f" ]; then
			rm -f "$f" 2>/dev/null || true
			removed=1
		fi
	done
	fallback_resolv_conf_direct
	if [ "$removed" -eq 1 ] && [ -x /etc/init.d/dnsmasq ]; then
		/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
	fi
}

stop_core_processes() {
	for p in $(pidof sing-box 2>/dev/null); do
		kill -TERM "$p" 2>/dev/null || true
	done
	local w=0
	while [ $w -lt 3 ]; do
		[ -z "$(pidof sing-box 2>/dev/null)" ] && break
		sleep 1
		w=$((w + 1))
	done
	for p in $(pidof sing-box 2>/dev/null); do
		kill -KILL "$p" 2>/dev/null || true
	done
}

mute_conflicting_services() {
	local auto_mute
	config_load 'ai-link'
	config_get_bool auto_mute 'global' 'auto_mute_conflicts' '1'
	[ "$auto_mute" -eq 0 ] && return 0

	mkdir -p "$RUN_DIR"
	for svc in homeproxy passwall passwall2 openclash nikki shadowsocksr v2ray_server; do
		if [ -x "/etc/init.d/$svc" ]; then
			if "/etc/init.d/$svc" running >/dev/null 2>&1 || pgrep -f "$svc" >/dev/null 2>&1; then
				logger -t ai-link "Muting conflicting proxy service: $svc"
				"/etc/init.d/$svc" stop >/dev/null 2>&1 || true
				"/etc/init.d/$svc" disable >/dev/null 2>&1 || true
				echo "$svc" >> "$RUN_DIR/muted_services.list"
			fi
		fi
	done
	for tbl in homeproxy fw4_homeproxy passwall passwall2 openclash nikki; do
		nft delete table inet "$tbl" 2>/dev/null || true
	done
	for rule_prio in $(ip rule show | awk '/lookup (100|101|8194|utun)/{gsub(":","",$1); print $1}'); do
		ip rule del priority "$rule_prio" 2>/dev/null || true
	done
	for rule6_prio in $(ip -6 rule show | awk '/lookup (100|101|8194|utun)/{gsub(":","",$1); print $1}'); do
		ip -6 rule del priority "$rule6_prio" 2>/dev/null || true
	done
}

# v1.0.2/v1.0.3 FIX: 探针原来只有 `ss -lntu`，而 ImmortalWrt 25.x / OpenWrt 24.10+ 默认不带 ss
# （实测 `ash: ss: not found`，返回 127），改用 netstat（busybox 自带）为主、ss 与 /proc 兜底。
port_is_listening() {
	local p="$1"
	[ -n "$p" ] || return 1
	if command -v netstat >/dev/null 2>&1; then
		netstat -tln 2>/dev/null | grep -q ":$p " && return 0
	fi
	if command -v ss >/dev/null 2>&1; then
		ss -lntu 2>/dev/null | grep -q ":$p " && return 0
	fi
	# 最后兜底：直接读 /proc/net/tcp{,6}（local_address 的端口是 16 进制，状态 0A = LISTEN）
	# B3-12: 同时传入大写与小写 16 进制，避免精简版 BusyBox awk 无 toupper()
	local hex lhex
	hex=$(printf '%04X' "$p" 2>/dev/null) || return 1
	lhex=$(printf '%04x' "$p" 2>/dev/null) || lhex="$hex"
	awk -v h="$hex" -v lh="$lhex" 'NR>1 { split($2, a, ":"); if ((a[2] == h || a[2] == lh) && $4 == "0A") { f = 1 } } END { exit(f ? 0 : 1) }' \
		/proc/net/tcp /proc/net/tcp6 2>/dev/null && return 0
	return 1
}

wait_for_ports_And_apply_nft() {
	local entry_bypass="$1"
	local block_quic="$2"
	local game_udp_direct="$3"
	local ipv6_proxy="$4"
	local unblock_enabled="0"
	local unblock_port="5210"
	local tproxy_port="$7"
	local mixed_port="$8"
	local panel_port="$9"

	(
		trap '' HUP
		local waited=0
		local budget="${AI_LINK_PORT_WAIT:-60}"
		while [ $waited -lt "$budget" ]; do
			if [ -f "$RUN_DIR/bypass" ] || [ -f "$RUN_DIR/recover_direct.flag" ]; then
				logger -t ai-link "Direct bypass flag active; skipping nftables mount."
				exit 0
			fi
			if port_is_listening "${tproxy_port:-7893}"; then
				break
			fi
			# DIAG-3 FIX: If sing-box exited or failed to spawn after 8s, proactively re-spawn once inside wait loop
			if [ $waited -eq 8 ] || [ $waited -eq 20 ]; then
				if ! singbox_alive && command -v sing-box >/dev/null 2>&1 && [ -f "$CONF_DIR/sing-box.json" ]; then
					logger -t ai-link "wait_for_ports: sing-box not alive at +${waited}s; triggering core spawn retry..."
					local sb_bin_retry
					sb_bin_retry=$(command -v sing-box 2>/dev/null || echo /usr/bin/sing-box)
					"$sb_bin_retry" run -c "$CONF_DIR/sing-box.json" -D "$CONF_DIR" >/dev/null 2>&1 &
				fi
			fi
			sleep 1
			waited=$((waited + 1))
		done

		if [ -f "$RUN_DIR/bypass" ] || [ -f "$RUN_DIR/recover_direct.flag" ]; then
			exit 0
		fi

		if ! port_is_listening "${tproxy_port:-7893}"; then
			cleanup_routing_and_nft
			cleanup_dnsmasq_upstream
			logger -t ai-link "WARN: TProxy port :${tproxy_port:-7893} not listening after ${budget}s! Cleaned routing/DNS and skipped nftables mount to protect LAN internet."
			exit 0
		fi

		setup_tun_and_routing
		sh "$FW_SCRIPT" \
			--entry-bypass "$entry_bypass" \
			--block-quic "$block_quic" \
			--game-udp-direct "$game_udp_direct" \
			--ipv6-proxy "$ipv6_proxy" \
			--unblock-enabled "$unblock_enabled" \
			--unblock-port "$unblock_port" \
			--tproxy-port "$tproxy_port" \
			--mixed-port "$mixed_port" \
			--panel-port "$panel_port" \
			--dns-port "7874"
		if command -v python3 >/dev/null 2>&1 && [ -f "$PROG_DAEMON" ]; then
			python3 -B "$PROG_DAEMON" --apply-dns-upstream >/dev/null 2>&1 || true
		fi
		restore_resolv_conf_local
		logger -t ai-link "TProxy port :${tproxy_port:-7893} ready; nftables table inet ai_link mounted."
	) </dev/null >/dev/null 2>&1 &
}

start_service() {
	config_load 'ai-link'
	local enabled panel_port tproxy_port mixed_port
	local entry_bypass block_quic game_udp_direct ipv6_proxy
	config_get_bool enabled 'global' 'enabled' '1'
	config_get panel_port 'global' 'panel_port' '9099'
	config_get tproxy_port 'global' 'tproxy_port' '7893'
	config_get mixed_port 'global' 'mixed_port' '7890'
	config_get_bool entry_bypass 'global' 'entry_bypass' '1'
	config_get_bool block_quic 'global' 'block_quic' '1'
	config_get_bool game_udp_direct 'global' 'game_udp_direct' '1'
	config_get_bool ipv6_proxy 'global' 'ipv6_proxy' '0'

	mkdir -p "$CONF_DIR" "$CONF_DIR/rules" "$CONF_DIR/certs" "$RUN_DIR" /var/etc/ai-link

	if [ "$enabled" -eq 1 ]; then
		rm -f "$RUN_DIR/bypass" "$RUN_DIR/recover_direct.flag" /tmp/ai-link-run/bypass 2>/dev/null || true
	else
		date +%s > "$RUN_DIR/bypass" 2>/dev/null || true
		touch "$RUN_DIR/recover_direct.flag" 2>/dev/null || true
	fi

	# Ensure router itself has working fallback DNS while starting up
	fallback_resolv_conf_direct

	# Sync UCI options into ops_settings.json before launching daemon
	if command -v python3 >/dev/null 2>&1 && [ -f "$PROG_DAEMON" ]; then
		python3 -B "$PROG_DAEMON" --sync-uci >/dev/null 2>&1 || true
	fi

	# Always start the AI-LINK Standalone Web Dashboard & Probe Daemon on :9099
	# P0-1 FIX (v1.0.3): Use `respawn 0 5 0` (unlimited retry=0) so procd never permanently abandons the daemon
	if command -v python3 >/dev/null 2>&1 && [ -f "$PROG_DAEMON" ]; then
		procd_open_instance "ai-link-daemon"
		procd_set_param command python3 -B "$PROG_DAEMON" --daemon --port "$panel_port"
		procd_set_param respawn 0 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	if [ "$enabled" -eq 0 ]; then
		cleanup_routing_and_nft
		stop_core_processes
		cleanup_dnsmasq_upstream
		logger -t ai-link "Transparent proxy is disabled in UCI (enabled=0); cleaned nftables & dnsmasq upstream, WebUI active on :$panel_port"
		return 0
	fi

	mute_conflicting_services
	stop_core_processes

	if command -v python3 >/dev/null 2>&1 && [ -f "$PROG_DAEMON" ]; then
		python3 -B "$PROG_DAEMON" --generate-configs >/dev/null 2>&1 || true
	fi
	ln -sf "$CONF_DIR/sing-box.json" /var/etc/ai-link/sing-box.json 2>/dev/null || true

	# P0-1 FIX (v1.0.3): Use `respawn 0 5 0` (threshold=0, timeout=5, retry=0) so procd NEVER enters
	# permanent "crash loop 6 crashes" abandonment when daemon reloads or restarts sing-box!
	if command -v sing-box >/dev/null 2>&1; then
		local sb_bin
		sb_bin=$(command -v sing-box 2>/dev/null || echo /usr/bin/sing-box)
		procd_open_instance "ai-link-core"
		procd_set_param command "$sb_bin" run -c "$CONF_DIR/sing-box.json" -D "$CONF_DIR"
		procd_set_param respawn 0 5 0
		procd_set_param limits nofile="65535 65535"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	else
		logger -t ai-link "WARN: sing-box binary not found; running in control-plane diagnostic mode."
		cleanup_routing_and_nft
		cleanup_dnsmasq_upstream
		return 0
	fi

	if [ -f "$FW_SCRIPT" ]; then
		wait_for_ports_And_apply_nft \
			"$entry_bypass" "$block_quic" "$game_udp_direct" "$ipv6_proxy" \
			"0" "5210" "$tproxy_port" "$mixed_port" "$panel_port"
	fi
}

stop_service() {
	cleanup_routing_and_nft
	stop_core_processes
	cleanup_dnsmasq_upstream
	logger -t ai-link "Stopped AI-LINK and rolled back nftables, policy routing, and dnsmasq upstream."
}

reload_service() {
	config_load 'ai-link'
	local enabled panel_port tproxy_port mixed_port
	local entry_bypass block_quic game_udp_direct ipv6_proxy
	config_get_bool enabled 'global' 'enabled' '1'
	config_get panel_port 'global' 'panel_port' '9099'
	config_get tproxy_port 'global' 'tproxy_port' '7893'
	config_get mixed_port 'global' 'mixed_port' '7890'
	config_get_bool entry_bypass 'global' 'entry_bypass' '1'
	config_get_bool block_quic 'global' 'block_quic' '1'
	config_get_bool game_udp_direct 'global' 'game_udp_direct' '1'
	config_get_bool ipv6_proxy 'global' 'ipv6_proxy' '0'

	mkdir -p "$RUN_DIR"
	if [ "$enabled" -eq 0 ]; then
		date +%s > "$RUN_DIR/bypass" 2>/dev/null || true
		touch "$RUN_DIR/recover_direct.flag" 2>/dev/null || true
		if command -v python3 >/dev/null 2>&1 && [ -f "$PROG_DAEMON" ]; then
			python3 -B "$PROG_DAEMON" --sync-uci >/dev/null 2>&1 || true
		fi
		cleanup_routing_and_nft
		stop_core_processes
		cleanup_dnsmasq_upstream
		logger -t ai-link "Reloaded with enabled=0: transparent proxy paused, nftables & dnsmasq upstream cleaned."
		return 0
	fi

	rm -f "$RUN_DIR/bypass" "$RUN_DIR/recover_direct.flag" /tmp/ai-link-run/bypass 2>/dev/null || true
	if command -v python3 >/dev/null 2>&1 && [ -f "$PROG_DAEMON" ]; then
		python3 -B "$PROG_DAEMON" --sync-uci >/dev/null 2>&1 || true
		python3 -B "$PROG_DAEMON" --generate-configs >/dev/null 2>&1 || true
		python3 -B "$PROG_DAEMON" --hot-reload >/dev/null 2>&1 || true
	fi

	if ! pgrep -f "ai-link-dae[m]on.py" >/dev/null 2>&1 || ! singbox_alive; then
		start
		return 0
	fi

	if port_is_listening "${tproxy_port:-7893}"; then
		setup_tun_and_routing
		if [ -f "$FW_SCRIPT" ]; then
			sh "$FW_SCRIPT" \
				--entry-bypass "$entry_bypass" \
				--block-quic "$block_quic" \
				--game-udp-direct "$game_udp_direct" \
				--ipv6-proxy "$ipv6_proxy" \
				--unblock-enabled "0" \
				--unblock-port "5210" \
				--tproxy-port "$tproxy_port" \
				--mixed-port "$mixed_port" \
				--panel-port "$panel_port" \
				--dns-port "7874"
		fi
		restore_resolv_conf_local
	fi
}

service_triggers() {
	procd_add_reload_trigger "ai-link"
}

EXTRA_COMMANDS="svc_state status_check status_ports_quiet recover_direct restore_proxy restart_core"
EXTRA_HELP="	svc_state	Machine-readable service state: daemon= core= nft= enabled= boot= bypass= port=
	status_check	Verify nftables table, policy route and daemon ports
	status_ports_quiet	Return 0 when both mixed (:7890) and TProxy (:7893) ports are listening
	recover_direct	Emergency bypass: remove nftables rules, clean dnsmasq upstream, and restore direct internet immediately
	restore_proxy	Exit emergency bypass and re-mount nftables rules + dnsmasq upstream
	restart_core	Restart or recover the sing-box core process without killing the web panel daemon"

status_ports_quiet() {
	config_load 'ai-link'
	local tproxy_port mixed_port
	config_get tproxy_port 'global' 'tproxy_port' '7893'
	config_get mixed_port 'global' 'mixed_port' '7890'
	port_is_listening "${tproxy_port:-7893}" && port_is_listening "${mixed_port:-7890}"
}

# P0-1 & P0-2 FIX (v1.0.3): Dedicated core recovery that resets procd instance state without killing ai-link-daemon
restart_core() {
	config_load 'ai-link'
	local enabled tproxy_port mixed_port panel_port
	local entry_bypass block_quic game_udp_direct ipv6_proxy
	config_get_bool enabled 'global' 'enabled' '1'
	config_get panel_port 'global' 'panel_port' '9099'
	config_get tproxy_port 'global' 'tproxy_port' '7893'
	config_get mixed_port 'global' 'mixed_port' '7890'
	config_get_bool entry_bypass 'global' 'entry_bypass' '1'
	config_get_bool block_quic 'global' 'block_quic' '1'
	config_get_bool game_udp_direct 'global' 'game_udp_direct' '1'
	config_get_bool ipv6_proxy 'global' 'ipv6_proxy' '0'

	[ "$enabled" -eq 0 ] && return 0
	[ -f "$RUN_DIR/bypass" ] && return 0

	stop_core_processes
	if [ ! -f "$CONF_DIR/sing-box.json" ] && command -v python3 >/dev/null 2>&1 && [ -f "$PROG_DAEMON" ]; then
		python3 -B "$PROG_DAEMON" --generate-configs >/dev/null 2>&1 || true
	fi
	if command -v sing-box >/dev/null 2>&1; then
		local sb_bin
		sb_bin=$(command -v sing-box 2>/dev/null || echo /usr/bin/sing-box)
		# Trigger procd start to reset any procd crash-loop counter, and fallback-spawn if procd is unavailable
		/etc/init.d/ai-link start >/dev/null 2>&1 || true
		sleep 2
		if ! singbox_alive; then
			( trap '' HUP; "$sb_bin" run -c "$CONF_DIR/sing-box.json" -D "$CONF_DIR" >/dev/null 2>&1 & )
		fi
		wait_for_ports_And_apply_nft \
			"$entry_bypass" "$block_quic" "$game_udp_direct" "$ipv6_proxy" \
			"0" "5210" "$tproxy_port" "$mixed_port" "$panel_port"
	fi
	return 0
}

# 供 LuCI / 面板「服务总开关」使用的机器可读状态（单行 key=value，便于前端解析）
svc_state() {
	config_load 'ai-link'
	local enabled panel_port daemon_up core_up nft_up boot_on bypass_up
	config_get_bool enabled 'global' 'enabled' '1'
	config_get panel_port 'global' 'panel_port' '9099'
	daemon_up=0; core_up=0; nft_up=0; boot_on=0; bypass_up=0
	pgrep -f "ai-link-dae[m]on.py" >/dev/null 2>&1 && daemon_up=1
	singbox_alive && core_up=1
	nft list table inet ai_link >/dev/null 2>&1 && nft_up=1
	ls /etc/rc.d/S*ai-link >/dev/null 2>&1 && boot_on=1
	[ -f "$RUN_DIR/bypass" ] && bypass_up=1
	echo "daemon=${daemon_up} core=${core_up} nft=${nft_up} enabled=${enabled} boot=${boot_on} bypass=${bypass_up} port=${panel_port}"
	return 0
}

recover_direct() {
	mkdir -p "$RUN_DIR" /tmp/ai-link-run
	date +%s > "$RUN_DIR/bypass"
	date +%s > "/tmp/ai-link-run/bypass"
	touch "$RUN_DIR/recover_direct.flag"
	uci set ai-link.global.enabled='0' 2>/dev/null || true
	uci commit ai-link 2>/dev/null || true
	if command -v python3 >/dev/null 2>&1 && [ -f "$PROG_DAEMON" ]; then
		python3 -B "$PROG_DAEMON" --sync-uci >/dev/null 2>&1 || true
	fi
	cleanup_routing_and_nft
	cleanup_dnsmasq_upstream
	echo "AI-LINK: Direct internet recovered (nftables table inet ai_link & dnsmasq upstream removed, UCI enabled=0 synced)."
}

restore_proxy() {
	rm -f "$RUN_DIR/bypass" "$RUN_DIR/recover_direct.flag" "/tmp/ai-link-run/bypass" 2>/dev/null || true
	uci set ai-link.global.enabled='1' 2>/dev/null || true
	uci commit ai-link 2>/dev/null || true
	if command -v python3 >/dev/null 2>&1 && [ -f "$PROG_DAEMON" ]; then
		python3 -B "$PROG_DAEMON" --sync-uci >/dev/null 2>&1 || true
		python3 -B "$PROG_DAEMON" --generate-configs >/dev/null 2>&1 || true
	fi
	if ! singbox_alive; then
		start
		echo "AI-LINK: Proxy service started and nftables rules + dnsmasq upstream restored."
		return 0
	fi
	config_load 'ai-link'
	local panel_port tproxy_port mixed_port
	local entry_bypass block_quic game_udp_direct ipv6_proxy
	config_get panel_port 'global' 'panel_port' '9099'
	config_get tproxy_port 'global' 'tproxy_port' '7893'
	config_get mixed_port 'global' 'mixed_port' '7890'
	config_get_bool entry_bypass 'global' 'entry_bypass' '1'
	config_get_bool block_quic 'global' 'block_quic' '1'
	config_get_bool game_udp_direct 'global' 'game_udp_direct' '1'
	config_get_bool ipv6_proxy 'global' 'ipv6_proxy' '0'
	local _rw=0
	while [ $_rw -lt 15 ]; do
		port_is_listening "${tproxy_port:-7893}" && break
		sleep 1
		_rw=$((_rw + 1))
	done
	if ! port_is_listening "${tproxy_port:-7893}"; then
		cleanup_routing_and_nft
		cleanup_dnsmasq_upstream
		logger -t ai-link "WARN: restore_proxy: TProxy port :${tproxy_port:-7893} not listening; skipping nftables mount to prevent blackhole."
		return 1
	fi
	setup_tun_and_routing
	if [ -f "$FW_SCRIPT" ]; then
		sh "$FW_SCRIPT" \
			--entry-bypass "$entry_bypass" \
			--block-quic "$block_quic" \
			--game-udp-direct "$game_udp_direct" \
			--ipv6-proxy "$ipv6_proxy" \
			--unblock-enabled "0" \
			--unblock-port "5210" \
			--tproxy-port "$tproxy_port" \
			--mixed-port "$mixed_port" \
			--panel-port "$panel_port" \
			--dns-port "7874"
	fi
	if command -v python3 >/dev/null 2>&1 && [ -f "$PROG_DAEMON" ]; then
		python3 -B "$PROG_DAEMON" --apply-dns-upstream >/dev/null 2>&1 || true
	fi
	restore_resolv_conf_local
	echo "AI-LINK: Transparent proxy nftables rules & dnsmasq upstream restored."
}

status_check() {
	echo "=== AI-LINK Service Status ==="
	echo "Core: $(pidof sing-box 2>/dev/null || pgrep -f '[s]ing-box run' 2>/dev/null || echo 'stopped')"
	echo "Daemon: $(pgrep -f 'ai-link-dae[m]on.py' 2>/dev/null || echo 'stopped')"
	echo "Bypass Flag: $([ -f "$RUN_DIR/bypass" ] && echo 'ACTIVE (Direct Mode)' || echo 'off')"
	echo "=== Policy Routing (table $TABLE_ID) ==="
	ip rule show | grep "$TABLE_ID" || echo "No IPv4 rule"
	ip -6 rule show | grep "$TABLE_ID" || echo "No IPv6 rule (expected when ipv6_proxy=0)"
	echo "=== nftables Table ==="
	nft list table inet ai_link 2>/dev/null | head -n 35 || echo "Table inet ai_link not loaded"
}
